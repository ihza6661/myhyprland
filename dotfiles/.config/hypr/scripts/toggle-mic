#!/bin/bash

# Debounce lock to prevent hardware double-firing (press + release)
LOCK="/tmp/mic-mute-lock"

if [[ -f "$LOCK" ]]; then
    rm -f "$LOCK"
    exit 0
fi

touch "$LOCK"
(sleep 0.5; rm -f "$LOCK" 2>/dev/null) &

# Toggle microphone mute
wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null 2>&1

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  omarchy-brightness-keyboard-mute on 2>/dev/null || true
  omarchy-osd -i microphone-muted -m "Microphone muted" 2>/dev/null || notify-send "Microphone MUTED" -t 1000
else
  omarchy-brightness-keyboard-mute off 2>/dev/null || true
  omarchy-osd -i microphone -m "Microphone on" 2>/dev/null || notify-send "Microphone on" -t 1000
fi

